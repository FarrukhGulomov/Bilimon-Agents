# Copy this file to .env and fill in real values before running in live (non-mock) mode.

# Which provider real (non-mock) LLM/web-search calls use. Default "openai".
# Set to "openrouter" to run against OpenRouter's OpenAI-compatible API
# instead (useful for testing different models/pricing) — see the
# OPENROUTER_* variables below when doing so.
# SEARCH_PROVIDER=openai

# --- OpenAI (SEARCH_PROVIDER=openai, the default) ---------------------------

# Required for real (non-mock) Discovery / Deep Research / Content Manager runs.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the model used for all LLM calls. Defaults to gpt-5.1.
# CAVEAT: model names change frequently and this default may already be
# stale — check https://platform.openai.com/docs/models for the actual
# current flagship model id before a real (non-mock) run, and set this if
# a newer model id is available.
OPENAI_MODEL=gpt-5.1

# Optional: per-call timeout in ms for OpenAI requests. Default 120000 (120s).
# OPENAI_TIMEOUT_MS=120000

# --- OpenRouter (SEARCH_PROVIDER=openrouter) --------------------------------

# Required when SEARCH_PROVIDER=openrouter. Get one at https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Required when SEARCH_PROVIDER=openrouter — no hardcoded default, since the
# whole point of this provider is testing a model/price point of your
# choosing. Browse ids at https://openrouter.ai/models (provider-prefixed,
# e.g. "openai/gpt-4o-mini", "google/gemini-2.5-flash", ...).
# OPENROUTER_MODEL=

# Optional: per-call timeout in ms for OpenRouter requests. Default 120000.
# OPENROUTER_TIMEOUT_MS=120000

# Optional: attribution headers OpenRouter uses for its dashboard/leaderboard.
# Harmless to leave unset.
# OPENROUTER_SITE_URL=https://bilimon.uz

# Optional: force mock/dry-run mode without passing --mock on the CLI.
# PIPELINE_MOCK=1

# --- Web frontend (src/server.ts, `npm start`) ------------------------------

# Port the web server listens on. Railway sets this automatically.
# PORT=3000

# Max "count" a web-form request may ask for in one run — a hard ceiling on
# real API spend per click from the open form. Default 50.
# PIPELINE_MAX_COUNT=50
